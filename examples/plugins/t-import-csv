#!/usr/bin/env python3
"""t import-csv: import tasks from a CSV file with a header row.

Usage:  t import-csv tasks.csv    (--dry-run prints the export)

Columns, in any order and any letter case (only the title is required):
  title (or task, name, description)   goal (or project)
  due, aim, after    dates as YYYY-MM-DD
  value (1-3)        size (S, M, L)     estimate (45m, 2h, or minutes)
  status (todo, started, waiting, done, dropped)

It builds a tend export and pipes it to `t import -`, so running it twice adds nothing twice.
"""
import csv
import json
import os
import re
import subprocess
import sys
from datetime import datetime

ALIASES = {"task": "title", "name": "title", "description": "title", "project": "goal", "priority": "value"}


def minutes(text: str) -> int | None:
    if m := re.fullmatch(r"(?:(\d+(?:\.\d+)?)h)?\s*(?:(\d+)m?)?", text.strip().lower()):
        if m[1] or m[2]:
            return round(float(m[1] or 0) * 60) + int(m[2] or 0)
    return None


def convert(rec: dict, n: int, created: str) -> dict | None:
    r = {ALIASES.get(k.strip().lower(), k.strip().lower()): (v or "").strip() for k, v in rec.items() if k}
    if not r.get("title"):
        return None
    state = r.get("status", "").lower() or "todo"
    value = int(r["value"]) if r.get("value", "") in ("1", "2", "3") else None
    size = r.get("size", "").upper() if r.get("size", "").upper() in ("S", "M", "L") else None
    return {
        "id": n, "title": r["title"], "created": created,
        "goal": re.sub(r"[^\w-]", "-", r["goal"].lower()) if r.get("goal") else None,
        "value": value, "size": size, "estimate_min": minutes(r.get("estimate", "")),
        "due": r.get("due") or None, "first_due": r.get("due") or None,
        "aim": r.get("aim") or None, "first_aim": r.get("aim") or None, "start_after": r.get("after") or None,
        "status": state if state in ("done", "dropped") else "open",
        "stage": state if state in ("started", "waiting") else "todo",
        "done_at": created if state in ("done", "dropped") else None,
    }


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if not args:
        sys.exit(__doc__)
    stamp = datetime.fromtimestamp(os.path.getmtime(args[0])).isoformat(timespec="seconds")
    with open(args[0], newline="", encoding="utf-8-sig") as f:
        rows = list(csv.DictReader(f))
    tasks = [t for t in (convert(r, i + 1, stamp) for i, r in enumerate(rows)) if t]
    goals = sorted({t["goal"] for t in tasks if t["goal"]})
    lines = [json.dumps({"format": "tend-export", "format_version": 1, "schema": 3})]
    lines += [json.dumps({"table": "goals", "row": {"name": g, "weekly_min": 0, "created": stamp}}) for g in goals]
    lines += [json.dumps({"table": "tasks", "row": t}) for t in tasks]
    export = "\n".join(lines) + "\n"
    if "--dry-run" in sys.argv:
        return print(export, end="")
    sys.exit(subprocess.run(["t", "import", "-"], input=export, text=True).returncode)


main()
