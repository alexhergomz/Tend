#!/usr/bin/env python3
"""t md: print the queue as a Markdown checklist, in tend's order.

Install: copy to a folder on your PATH (for example ~/.local/bin) and chmod +x.
Usage:   t md > todo.md
"""
import json
import subprocess

tasks = json.loads(subprocess.run(["t", "ls", "--json"], capture_output=True, text=True, check=True).stdout)
for t in tasks:
    extra = [f"+{t['goal']}"] if t["goal"] else []
    extra += [f"due {t['due']}"] if t["due"] else []
    print(f"- [ ] {t['title']}" + (f" ({', '.join(extra)})" if extra else ""))
