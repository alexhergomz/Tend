#!/usr/bin/env python3
"""t pushed: show the tasks whose dates moved later most often, with their history.

tend counts push-backs but doesn't act on them. This plugin reads the data
directly from the database, as an example of building on it.

Install: copy to a folder on your PATH and chmod +x.   Usage: t pushed
"""
import json
import os
import sqlite3

db = sqlite3.connect(os.environ["TEND_DB"])  # set by tend for every plugin
db.row_factory = sqlite3.Row
rows = db.execute("SELECT id, title, pushes, first_due, first_aim, due, aim FROM tasks "
                  "WHERE status = 'open' AND pushes > 0 ORDER BY pushes DESC LIMIT 10").fetchall()
if not rows:
    print("No task has been pushed back.")
for r in rows:
    first, now = (r["first_due"], r["due"]) if r["first_due"] else (r["first_aim"], r["aim"])
    print(f"#{r['id']}  {r['title']}  ·  pushed {r['pushes']}×  ·  first date {first}, now {now}")
    # every date change is in the events table, with the row before and after
    for ev in db.execute("SELECT ts, kind, changes FROM events WHERE undone = 0 ORDER BY id"):
        for ch in json.loads(ev["changes"]):
            before, after = ch.get("before") or {}, ch.get("after") or {}
            if ch["id"] != r["id"]:
                continue
            for key in ("due", "aim"):
                if before.get(key) and after.get(key) and after[key] > before[key]:
                    print(f"      {ev['ts'][:10]}  {ev['kind']:<9} {key} {before[key]} → {after[key]}")
